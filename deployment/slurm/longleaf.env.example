REPO_ROOT=/path/to/chess-engine
ARTIFACT_ROOT=/path/to/chess-engine/artifacts
APPTAINER_IMAGE=/path/to/chess-engine.sif
CUDA_ROOT=/nas/longleaf/rhel9/apps/cuda/13.0
SELF_PLAY_BIN=/path/to/repo/build-longleaf-cuda13/self_play

LOOP_ITERATIONS=10
SELFPLAY_GAMES=2000
SELFPLAY_SIMULATIONS=300
SELFPLAY_MAX_PLAYS=512
SELFPLAY_CONCURRENCY=512
SELFPLAY_BATCH=256
SELFPLAY_BATCH_TIMEOUT_US=1000

REPLAY_WINDOW=20
TRAIN_EPOCHS=5
TRAIN_LR=3e-4
WARM_START=1
LC0_FRACTION=1.0
LC0_DATASET_DIR=/path/to/lc0/v2/shards

WANDB_ENABLED=1
WANDB_PROJECT=chess-engine
WANDB_MODE=online
