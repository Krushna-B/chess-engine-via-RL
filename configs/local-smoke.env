# One local generation suitable for a smoke test 
LOOP_ITERATIONS=1
SELFPLAY_GAMES=8
SELFPLAY_SIMULATIONS=32
SELFPLAY_MAX_PLAYS=256
SELFPLAY_CONCURRENCY=8
SELFPLAY_BATCH=8
SELFPLAY_BATCH_TIMEOUT_US=1000

REPLAY_WINDOW=4
TRAIN_EPOCHS=1
TRAIN_LR=3e-4
WARM_START=1

# Optional identity/output overrides:
# RUN_ID=my_experiment
# METRICS_PATH=artifacts/metrics/my_experiment.jsonl
# SELFPLAY_SHARD_PATH=artifacts/selfplay/my_shard.bin
