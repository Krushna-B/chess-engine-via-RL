REPO_ROOT=/path/to/chess-engine
ARTIFACT_ROOT=/path/to/chess-engine/artifacts
APPTAINER_IMAGE=/path/to/chess-engine.sif
CUDA_ROOT=/nas/longleaf/rhel9/apps/cuda/13.0
SELF_PLAY_BIN=/path/to/repo/build-longleaf-cuda13/self_play
CHECKPOINT_DIR=/path/to/chess-engine/artifacts/checkpoints/test91

LOOP_ITERATIONS=10
SELFPLAY_GAMES=2000
SELFPLAY_SIMULATIONS=300
SELFPLAY_MAX_PLAYS=512
SELFPLAY_CONCURRENCY=512
SELFPLAY_BATCH=256
SELFPLAY_BATCH_TIMEOUT_US=1000

REPLAY_WINDOW=20
TRAIN_EPOCHS=5
TRAIN_LR=3e-4
TRAIN_EXAMPLES_PER_EPOCH=1000000
TRAIN_BATCH_SIZE=64
TRAIN_NUM_WORKERS=2
TRAIN_PREFETCH_FACTOR=4
TRAIN_PIN_MEMORY=1
TRAIN_LOG_EVERY_STEPS=50
TRAIN_CHECKPOINT_EVERY_STEPS=1000
TRAIN_RESUME=1
TRAIN_COMPILE=1
TRAIN_FUSED_ADAMW=1
TRAIN_TF32=1
WARM_START=1
LC0_FRACTION=1.0
LC0_DATASET_DIR=/path/to/lc0/v2/samples
LC0_TAR_LIST=/path/to/lc0/test91_tar_files.txt
LC0_SHARD_ROOT=/path/to/lc0/v2/shards
LC0_POSITIONS_PER_SHARD=250000
LC0_SAMPLE_ROOT=/path/to/lc0/v2/samples
LC0_SAMPLE_PER_ARCHIVE=5000

WANDB_ENABLED=1
WANDB_PROJECT=chess-engine
WANDB_MODE=online
WANDB_GROUP=test91-curriculum
WANDB_RUN_ID=test91-phase-1
WANDB_RESUME=allow
WANDB_TAGS=longleaf,lc0,ddp
